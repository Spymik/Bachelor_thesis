# Copy to .env and adjust. Never commit the real .env — it is gitignored.

# development | production | testing
APP_ENV=development

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-insecure-key

LOG_LEVEL=INFO

# --- Paths -------------------------------------------------------------
# Defaults are ./models and ./data relative to the project root.
# MODELS_DIR=/srv/paw-patrol/models
# DATA_DIR=/srv/paw-patrol/data

# --- Model weights (filenames inside MODELS_DIR) -----------------------
IMAGE_MODEL=mix.pt
VIDEO_MODEL=wildlide.pt
STREAM_MODEL=wildlide.pt

# --- Inference ---------------------------------------------------------
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
# Leave blank to let ultralytics pick. Or: cpu, 0, 0,1
DEVICE=

# --- Uploads -----------------------------------------------------------
MAX_UPLOAD_MB=256

# --- Live sources ------------------------------------------------------
# Credentials belong here, never in source. Example:
#   RTSP_URL=rtsp://user:password@192.168.1.10:554/stream1
RTSP_URL=
WEBCAM_INDEX=0
STREAM_SKIP_FRAMES=2
STREAM_JPEG_QUALITY=80
